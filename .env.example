# ==========================================
# HOTEL BOOKING SYSTEM - ENVIRONMENT EXAMPLE
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=hotel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecureRootPassword_2026!#

# Dedicated Application DB User (Least Privilege)
DB_USER=hotel_user
DB_PASSWORD=YourSecureAppPassword_2026!#
DB_NAME=hotel_db
DB_HOST=postgres
DB_PORT=5432

# Application Configuration
APP_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@hotel.com
PGADMIN_DEFAULT_PASSWORD=YourPgAdminPassword_2026!#
PGADMIN_PORT=5050

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YourGrafanaPassword_2026!#
GRAFANA_PORT=3001

# Prometheus Configuration
PROMETHEUS_PORT=9090

# Loki Configuration
LOKI_PORT=3100

# Nginx External Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
